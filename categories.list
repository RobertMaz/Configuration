# Категории правил (blackmatrix7/ios_rule_script), сливаются с proxy.list при сборке.
# Формат строки: имя=Папка (имя — для людей, Папка — точное имя в rule/Clash, регистр важен).
# Секция [reject] — то, что блокируется (реклама): уходит в reject.list и в block роутера.
# Правка этого файла = push; Action пересоберёт generated/.

[proxy]
telegram=Telegram
youtube=YouTube
whatsapp=Whatsapp
instagram=Instagram
twitter=Twitter
facebook=Facebook
discord=Discord
copilot=Copilot
notion=Notion
gemini=Gemini
claude=Claude
jetbrains=Jetbrains

[reject]
# глобальная реклама (blackmatrix7, ~38k) — проверенная база
ads=AdvertisingLite
# RU-специфика (runetfreedom) — ВЫКЛЮЧЕНА 22.11: 80k доменов положили роутер
# (медленные соединения через перехват). Вернуть тюнингом: cap<=50k в build.py
# и/или без DOMAIN-KEYWORD-вытяжки.
# ads-ru=geosite:category-ads-all@https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat
